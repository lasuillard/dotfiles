{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lasuillard/renovate-config"
  ],
  "ignoreDeps": [
    "my-agents",
    "my-secrets"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group for all Nix inputs except some specific ones",
      "groupName": "Nix Inputs",
      "groupSlug": "nix-inputs",
      "matchManagers": [
        "nix"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ]
}
