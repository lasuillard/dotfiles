{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lasuillard/renovate-config"
  ],
  "ignoreDeps": [
    "my-secrets"
  ],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": [
        "* 0-3 * * 1"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  },
  "packageRules": [
    {
      "description": "Group non-major Nix input updates",
      "groupName": "Nix Inputs",
      "groupSlug": "nix-inputs",
      "matchManagers": [
        "nix"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    }
  ]
}
